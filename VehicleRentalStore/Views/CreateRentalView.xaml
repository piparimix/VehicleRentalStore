<UserControl
    x:Class="VehicleRentalStore.Views.CreateRentalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VehicleRentalStore.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="907"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border
        MaxWidth="800"
        Margin="20"
        Padding="30"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="{DynamicResource PanelBackgroundBrush}"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock
                    FontSize="28"
                    FontWeight="ExtraBold"
                    Foreground="{DynamicResource TextHighBrush}"
                    Text="Create New Rental" />
                <Rectangle
                    Height="2"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    Fill="{DynamicResource BorderBrush}" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Padding="0,0,15,0"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Margin="0,0,0,15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Customer Information" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Select Customer" />
                        <ComboBox
                            Height="35"
                            Margin="0,0,0,25"
                            ItemsSource="{Binding Customers}"
                            SelectedItem="{Binding SelectedCustomer}"
                            DisplayMemberPath="FullName"
                            IsEditable="True"
                            TextSearch.TextPath="FullName" />

                        <TextBlock
    Margin="0,0,0,15"
    FontWeight="Bold"
    Foreground="{DynamicResource TextHighBrush}"
    Text="Vehicle Selection" />

                        <TextBlock
    Margin="0,0,0,5"
    FontSize="12"
    Opacity="0.7"
    Text="Selected Vehicle" />

                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox 
        Grid.Column="0" 
        Height="35" 
        IsReadOnly="True" 
        Text="{Binding SelectedVehicle.FullName, Mode=OneWay}" 
        Background="{DynamicResource ControlBackgroundBrush}" />

                            <Button 
        Grid.Column="1" 
        Width="90" 
        Height="35" 
        Margin="10,0,0,0" 
        Content="Browse..." 
        Command="{Binding OpenSelectVehicleCommand}" />
                        </Grid>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Starting Condition" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Odometer Reading (km)" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding StartOdometer}" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Fuel Level (%)" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,25"
                            Text="{Binding StartFuelLevel}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock
                            Margin="0,0,0,15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Rental Period" />

                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Start Date" />
                                <DatePicker Height="35" SelectedDate="{Binding StartDate}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Expected End Date" />
                                <DatePicker Height="35" SelectedDate="{Binding ExpectedEndDate}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Logistics" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Pickup Location" />
                        <ComboBox
                            Height="35"
                            Margin="0,0,0,15"
                            ItemsSource="{Binding Locations}"
                            SelectedItem="{Binding PickupLocation}"
                            DisplayMemberPath="Name" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Drop-off Location" />
                        <ComboBox
                            Height="35"
                            Margin="0,0,0,25"
                            ItemsSource="{Binding Locations}"
                            SelectedItem="{Binding DropoffLocation}"
                            DisplayMemberPath="Name" />

                        <TextBlock
                            Margin="0,0,0,15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Billing and Insurance" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Insurance Plan" />
                        <ComboBox
                            Height="35"
                            Margin="0,0,0,15"
                            ItemsSource="{Binding InsurancePlans}"
                            SelectedItem="{Binding SelectedInsurancePlan}"
                            DisplayMemberPath="Name" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Security Deposit" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding SecurityDeposit}" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Button
                Grid.Row="2"
                Height="45"
                Margin="0,20,0,0"
                Content="Save Rental"
                Command="{Binding SaveRentalCommand}"
                FontSize="16"
                FontWeight="Bold"
                Style="{StaticResource SuccessButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
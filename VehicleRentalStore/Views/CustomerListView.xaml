<UserControl
    x:Class="VehicleRentalStore.Views.CustomerListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VehicleRentalStore.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VehicleRentalStore.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Grid Margin="20" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{DynamicResource TextHighBrush}"
                Text="Customers" />

            <Border
                Grid.Column="1"
                Height="38"
                Margin="0,0,15,0"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="12,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="&#xE721;" />

                    <TextBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Text="Search customers..." />
                </Grid>
            </Border>

            <Button
                Grid.Column="2"
                Height="38"
                Padding="20,0"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{x:Type viewmodels:RegisterCustomerViewModel}"
                Style="{StaticResource SuccessButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        Text="&#xE710;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="New Customer" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0"
            Style="{StaticResource BorderStyle}">
            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="0"
                IsReadOnly="True"
                ItemsSource="{Binding Customers}"
                RowDetailsVisibilityMode="VisibleWhenSelected"
                Style="{StaticResource {x:Type DataGrid}}">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="1.5*" Header="Customer">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextHighBrush}"
                                        Text="{Binding FullName}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding Email}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="140" Header="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="{Binding Type}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding PhoneNumber}"
                        Header="Phone" />

                    <DataGridTemplateColumn Width="150" Header="License Number">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontWeight="SemiBold"
                                        Text="{Binding DriversLicenseNumber}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Background="Transparent"
                                    Foreground="{DynamicResource PrimaryAccentBrush}"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTip="Edit Customer">
                                    <TextBlock
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xE70F;" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border
                            Margin="10,5,10,10"
                            Padding="15"
                            Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,2"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="Address" />
                                    <TextBlock Foreground="{DynamicResource TextHighBrush}" Text="{Binding Address}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Margin="0,0,0,2"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="Date of Birth" />
                                    <TextBlock Foreground="{DynamicResource TextHighBrush}" Text="{Binding DateOfBirth, StringFormat=d}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,2"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="SSN / Tax ID" />
                                    <TextBlock Foreground="{DynamicResource TextHighBrush}" Text="{Binding Ssn}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock
                                        Margin="0,0,0,2"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        Text="License Expiry" />
                                    <TextBlock
                                        Foreground="{DynamicResource TextHighBrush}"
                                        Text="{Binding LicenseExpiryDate, StringFormat=d}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

            </DataGrid>
        </Border>
    </Grid>
</UserControl>
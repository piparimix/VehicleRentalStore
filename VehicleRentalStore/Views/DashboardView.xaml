<UserControl
    x:Class="VehicleRentalStore.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="20" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,20"
            FontSize="24"
            FontWeight="Bold"
            Foreground="{DynamicResource TextHighBrush}"
            Text="Ajoneuvokanta (Fleet)" />

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Fleet}"
            Style="{StaticResource {x:Type DataGrid}}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Brand}"
                    Header="Brand" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Model}"
                    Header="Model" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding ManufactureYear}"
                    Header="Year" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding LicensePlate}"
                    Header="License Plate" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding DailyRate, StringFormat={}{0:F2}}"
                    Header="Daily Rate (€)" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding CurrentOdometerKm}"
                    Header="Odometer (km)" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
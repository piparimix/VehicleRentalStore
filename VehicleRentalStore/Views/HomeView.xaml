<UserControl
    x:Class="VehicleRentalStore.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VehicleRentalStore.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="8,8,8,8"
            Style="{StaticResource BorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextHighBrush}"
                        Text="Welcome back, Jesse!" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource TextHighBrush}"
                        Text="Here is today's overview for the rental store." />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextHighBrush}"
                    Text="Friday, May 15" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource BorderStyle}">
                    <TextBlock
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    FontSize="18"
    Foreground="{DynamicResource TextHighBrush}"
    Text="{Binding AvailableCars, StringFormat='Available Cars: {0}'}" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource BorderStyle}">
                    <TextBlock
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    FontSize="18"
    Foreground="{DynamicResource TextHighBrush}"
    Text="{Binding AvailableMotorcycles, StringFormat='Available Motorcycles: {0}'}" />
                </Border>
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource BorderStyle}">
                    <TextBlock
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    FontSize="18"
    Foreground="{DynamicResource TextHighBrush}"
    Text="{Binding ActiveRentals, StringFormat='Active Rentals: {0}'}" />
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource BorderStyle}">
                    <TextBlock
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    FontSize="18"
    Foreground="{DynamicResource TextHighBrush}"
    Text="{Binding RevenueToday, StringFormat='Revenue Today: {0:C}'}" />
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource BorderStyle}">
                    <TextBlock
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    FontSize="18"
    Foreground="{DynamicResource TextHighBrush}"
    Text="{Binding OverdueRentals, StringFormat='Overdue Rentals: {0}'}" />
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource BorderStyle}">
                    <TextBlock
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    FontSize="18"
    Foreground="{DynamicResource TextHighBrush}"
    Text="{Binding TotalCustomers, StringFormat='Total Customers: {0}'}" />
                </Border>



            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="10"
                Style="{StaticResource BorderStyle}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextHighBrush}"
                        Text="Quick Actions" />

                    <Button
                        Margin="0,0,0,10"
                        Padding="8"
                        Command="{Binding OpenRegisterCustomerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                Text="&#xE710;" />
                            <TextBlock VerticalAlignment="Center" Text="Register New Customer" />
                        </StackPanel>
                    </Button>

                    <Button Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                Text="&#xE710;" />
                            <TextBlock VerticalAlignment="Center" Text="Register New Rental" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource BorderStyle}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{DynamicResource TextHighBrush}"
                    Text="Recent Activity" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
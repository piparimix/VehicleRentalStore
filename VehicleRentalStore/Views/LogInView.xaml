<UserControl x:Class="VehicleRentalStore.Views.LogInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VehicleRentalStore.Views"
             xmlns:viewmodels="clr-namespace:VehicleRentalStore.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:LogInViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LoginInputControlStyle" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox" BasedOn="{StaticResource LoginInputControlStyle}">
            <Setter Property="CaretBrush" Value="{DynamicResource TextHighBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource LoginInputControlStyle}">
            <Setter Property="CaretBrush" Value="{DynamicResource TextHighBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Width="420" 
                Padding="45,40,45,45" 
                Background="{DynamicResource PanelBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="12"
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.3" Direction="270" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <Border Width="64" Height="64" 
                        Background="{DynamicResource ControlBackgroundBrush}" 
                        CornerRadius="32" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,20"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <TextBlock FontFamily="Segoe MDL2 Assets" 
                               Text="&#xE804;" 
                               FontSize="26" 
                               Foreground="{DynamicResource PrimaryAccentBrush}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Employee Portal" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextHighBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,6"/>

                <TextBlock Text="Please sign in to access your dashboard" 
                           FontSize="13" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,32"/>

                <TextBlock Text="EMAIL ADDRESS" 
                           FontSize="10" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           Margin="2,0,0,6"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,22"/>

                <TextBlock Text="PASSWORD" 
                           FontSize="10" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           Margin="2,0,0,6"/>
                <PasswordBox x:Name="UserPasswordBox" 
                             Margin="0,0,0,12"/>

                <Border x:Name="ErrorBox" 
                        Background="#2A181B" 
                        BorderBrush="{DynamicResource ErrorBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,10"
                        Margin="0,10,0,15"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   Text="&#xEA39;" 
                                   Foreground="{DynamicResource ErrorBrush}" 
                                   VerticalAlignment="Top" 
                                   FontSize="14" 
                                   Margin="0,1,10,0"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding ErrorMessage}" 
                                   Foreground="{DynamicResource ErrorBrush}" 
                                   FontSize="13" 
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Button Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=UserPasswordBox}"
                        Height="46"
                        Margin="0,12,0,0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sign In" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72A;" Margin="10,1,0,0" VerticalAlignment="Center" FontSize="11" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
<Window x:Class="VehicleRentalStore.Views.LogInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:VehicleRentalStore.Components"
        xmlns:views="clr-namespace:VehicleRentalStore.Views"
        xmlns:viewmodels="clr-namespace:VehicleRentalStore.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:LogInViewModel}"
        Title="Employee Login" 
        Height="650" 
        Width="450"
        Style="{StaticResource {x:Type Window}}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:CustomTitleBar Grid.Row="0" />

        <views:LogInView Grid.Row="1" />
    </Grid>
</Window>
<UserControl
    x:Class="VehicleRentalStore.Views.RegisterCustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VehicleRentalStore.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <Border
        MaxWidth="800"
        Margin="20"
        Padding="30"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="{DynamicResource PanelBackgroundBrush}"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header Section  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock
                    FontSize="28"
                    FontWeight="ExtraBold"
                    Foreground="{DynamicResource TextHighBrush}"
                    Text="Register New Customer" />
                <Rectangle
                    Height="2"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Stretch"
                    Fill="{DynamicResource BorderBrush}" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Padding="0,0,15,0"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Personal Information" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="First Name" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding FirstName}" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Last Name" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding LastName}" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Email Address" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding Email}" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Address" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,25"
                            Text="{Binding Address}" />

                        <TextBlock
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Customer Type" />
                        <Border
                            Padding="15"
                            Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Margin="0,0,15,0"
                                    Content="Private"
                                    IsChecked="{Binding IsIndividual}" />
                                <RadioButton
                                    Margin="0,0,15,0"
                                    Content="Company"
                                    IsChecked="{Binding IsCompany}" />
                                <RadioButton Content="Organization" IsChecked="{Binding IsOther}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Driving License Details" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="License Number" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding DriversLicenseNumber}" />

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Date of Birth" />
                                <DatePicker Height="35" SelectedDate="{Binding DateOfBirth}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Expiry Date" />
                                <DatePicker Height="35" SelectedDate="{Binding LicenseExpiryDate}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Approved Categories" />
                        <Border
                            Padding="10"
                            Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="8">
                            <UniformGrid Columns="3">
                                <CheckBox
                                    Margin="5"
                                    Content="T"
                                    IsChecked="{Binding HasLicenseT}" />
                                <CheckBox
                                    Margin="5"
                                    Content="AM/120"
                                    IsChecked="{Binding HasLicenseAM120}" />
                                <CheckBox
                                    Margin="5"
                                    Content="AM/121"
                                    IsChecked="{Binding HasLicenseAM121}" />
                                <CheckBox
                                    Margin="5"
                                    Content="A1"
                                    IsChecked="{Binding HasLicenseA1}" />
                                <CheckBox
                                    Margin="5"
                                    Content="A2"
                                    IsChecked="{Binding HasLicenseA2}" />
                                <CheckBox
                                    Margin="5"
                                    Content="A"
                                    IsChecked="{Binding HasLicenseA}" />
                                <CheckBox
                                    Margin="5"
                                    Content="B"
                                    IsChecked="{Binding HasLicenseB}" />
                                <CheckBox
                                    Margin="5"
                                    Content="BE"
                                    IsChecked="{Binding HasLicenseBE}" />
                                <CheckBox
                                    Margin="5"
                                    Content="C1"
                                    IsChecked="{Binding HasLicenseC1}" />
                                <CheckBox
                                    Margin="5"
                                    Content="C"
                                    IsChecked="{Binding HasLicenseC}" />
                                <CheckBox
                                    Margin="5"
                                    Content="D1"
                                    IsChecked="{Binding HasLicenseD1}" />
                                <CheckBox
                                    Margin="5"
                                    Content="D"
                                    IsChecked="{Binding HasLicenseD}" />
                            </UniformGrid>
                        </Border>

                        <TextBlock
                            Margin="0,15,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Phone Number" />
                        <TextBox Height="35" Text="{Binding PhoneNumber}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!--  Submit Button  -->
            <Button
                Grid.Row="2"
                Height="45"
                Margin="0,20,0,0"
                Command="{Binding RegisterCustomerCommand}"
                Content="REGISTER CUSTOMER"
                FontSize="16"
                FontWeight="Bold"
                Style="{StaticResource SuccessButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
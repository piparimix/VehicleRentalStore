<UserControl
    x:Class="VehicleRentalStore.Views.RegisterVehicleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="850"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <Border
        MaxWidth="800"
        Margin="20"
        Padding="30"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="{DynamicResource PanelBackgroundBrush}"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock
                    FontSize="28"
                    FontWeight="ExtraBold"
                    Foreground="{DynamicResource TextHighBrush}"
                    Text="Register New Vehicle" />
                <Rectangle
                    Height="2"
                    Margin="0,5,0,0"
                    Fill="{DynamicResource BorderBrush}" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Padding="0,0,15,0"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Vehicle Classification" />
                        <Border
                            Margin="0,0,0,15"
                            Padding="12"
                            Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    x:Name="RadioCar"
                                    Margin="0,0,25,0"
                                    Content="Car"
                                    IsChecked="{Binding IsCarType, Mode=TwoWay}" />
                                <RadioButton
                                    x:Name="RadioMotorcycle"
                                    Content="Motorcycle"
                                    IsChecked="{Binding IsMotorcycleType, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="0,0,0,15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Vehicle Identity" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Brand" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding Brand}" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Model" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding Model}" />

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="License Plate" />
                                <TextBox Height="35" Text="{Binding LicensePlate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Year" />
                                <TextBox Height="35" Text="{Binding ManufactureYear}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Transmission Type" />
                        <Border
                            Margin="0,0,0,15"
                            Padding="10"
                            Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    Margin="0,0,20,0"
                                    Content="Manual"
                                    IsChecked="{Binding IsManual}" />
                                <RadioButton Content="Automatic" IsChecked="{Binding IsAutomatic}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="Fuel Type" />
                        <Border
                            Padding="10"
                            Background="{DynamicResource AppBackgroundBrush}"
                            CornerRadius="8">
                            <UniformGrid Columns="2">
                                <RadioButton
                                    Margin="0,2"
                                    Content="Gasoline"
                                    IsChecked="{Binding IsGasoline}" />
                                <RadioButton
                                    Margin="0,2"
                                    Content="Diesel"
                                    IsChecked="{Binding IsDiesel}" />
                                <RadioButton
                                    Margin="0,2"
                                    Content="Electric"
                                    IsChecked="{Binding IsElectric}" />
                                <RadioButton
                                    Margin="0,2"
                                    Content="Hybrid"
                                    IsChecked="{Binding IsHybrid}" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,15"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Technical Specifications" />

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="12"
                            Opacity="0.7"
                            Text="VIN / Chassis Number" />
                        <TextBox
                            Height="35"
                            Margin="0,0,0,15"
                            Text="{Binding VIN}" />

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Odometer (km)" />
                                <TextBox Height="35" Text="{Binding CurrentOdometerKm}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Color" />
                                <TextBox Height="35" Text="{Binding PrimaryColor}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=RadioCar, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="Doors" />
                                    <TextBox Height="35" Text="{Binding NumberOfDoors}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="Seats" />
                                    <TextBox Height="35" Text="{Binding PassengerCapacity}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="Cargo (L)" />
                                    <TextBox Height="35" Text="{Binding CargoCapacityLiters}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=RadioMotorcycle, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="Displacement (cc)" />
                                    <TextBox
                                        Width="100"
                                        Height="35"
                                        Text="{Binding EngineCapacityCc}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <Border
                                        Padding="10"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        CornerRadius="6">
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="Special License Required"
                                            Foreground="{DynamicResource TextHighBrush}"
                                            IsChecked="{Binding RequiresSpecialLicense}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Tank Capacity (L)" />
                                <TextBox Height="35" Text="{Binding FuelTankCapacityLiters}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Battery Capacity (kWh)" />
                                <TextBox Height="35" Text="{Binding BatteryCapacityKWh}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,0,0,5"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextHighBrush}"
                            Text="Pricing &amp; Rental Rates" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Daily Rate (€)" />
                                <TextBox Height="35" Text="{Binding DailyRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Hourly Rate (€)" />
                                <TextBox Height="35" Text="{Binding HourlyRate}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Button
                Grid.Row="2"
                Height="45"
                Margin="0,20,0,0"
                Command="{Binding RegisterVehicleCommand}"
                Content="REGISTER VEHICLE"
                Style="{StaticResource SuccessButtonStyle}" />
        </Grid>
    </Border>
</UserControl>